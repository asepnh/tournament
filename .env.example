# Postgres connection string (Vercel Postgres / Neon in production, local Prisma dev server locally)
DATABASE_URL="postgresql://user:password@localhost:5432/pickleball"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of the deployed app, used to build shareable tournament links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
